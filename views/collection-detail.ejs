<%- include('_header', { page: 'collections', pageTitle: collection.name }) %>

<div class="grid-toolbar" id="grid-toolbar">
  <div class="grid-toolbar__breadcrumb">
    <a href="/collections" class="back-link">&#8592; Collections</a>
    <h1 class="grid-toolbar__title"><%= collection.name %></h1>
  </div>
  <span class="grid-toolbar__count" id="grid-count">
    <%= images.length %> <%= images.length === 1 ? 'image' : 'images' %>
  </span>
  <div class="grid-toolbar__actions" id="grid-toolbar-actions">
    <button class="btn btn--small btn--secondary" id="share-open-btn" type="button">Share</button>
    <% if (images.length > 0) { %>
    <button class="btn btn--small btn--secondary" id="grid-select-btn" type="button">Select</button>
    <% } %>
  </div>
</div>

<% if (images.length === 0) { %>
<p class="image-grid__empty">No images yet &mdash; add some from <a href="/allimages">All Images</a></p>
<% } else { %>
<div class="photo-grid image-grid" id="image-grid">
  <% images.forEach(function(img) { %>
  <div class="photo-card image-card" data-id="<%= img.id %>">
    <label class="image-card__select">
      <input type="checkbox" class="image-card__checkbox" value="<%= img.id %>" aria-label="Select image">
    </label>
    <a href="/collections/<%= collection.slug %>/image/<%= img.id %>" class="photo-card__link image-card__link">
      <img src="/image/<%= img.id %>/thumb.jpg" alt="Uploaded image" class="image-card__img" loading="lazy">
      <time class="image-card__date" datetime="<%= img.created_at %>"><%= img.created_at %></time>
    </a>
  </div>
  <% }); %>
</div>
<% } %>

<form id="remove-form" action="/collections/<%= collection.slug %>/remove" method="post"></form>
<form id="delete-form" action="/collections/<%= collection.slug %>/delete" method="post"></form>

<div class="modal-backdrop" id="remove-modal" role="dialog" aria-modal="true" aria-labelledby="remove-modal-msg" hidden>
  <div class="modal">
    <p class="modal__body" id="remove-modal-msg">Remove the selected images from this collection? The images will not be deleted.</p>
    <div class="modal__actions">
      <button id="remove-cancel-btn" class="btn" type="button">Cancel</button>
      <button id="remove-confirm-btn" class="btn btn--secondary" type="button">Remove</button>
    </div>
  </div>
</div>

<div class="modal-backdrop" id="delete-modal" role="dialog" aria-modal="true" aria-labelledby="delete-modal-msg" hidden>
  <div class="modal">
    <p class="modal__body" id="delete-modal-msg">Permanently delete the selected images? They will be removed from all collections and cannot be recovered.</p>
    <div class="modal__actions">
      <button id="delete-cancel-btn" class="btn" type="button">Cancel</button>
      <button id="delete-confirm-btn" class="btn btn--danger" type="button">Delete permanently</button>
    </div>
  </div>
</div>

<div class="modal-backdrop" id="share-modal" role="dialog" aria-modal="true" aria-labelledby="share-modal-title"<%= openShareModal ? '' : ' hidden' %>>
  <div class="modal modal--form share-modal">
    <h2 class="modal__title" id="share-modal-title">Share collection</h2>

    <% if (shareError) { %>
    <div class="banner banner--error" role="alert"><%= shareError %></div>
    <% } %>

    <% if (newShareUrl) { %>
    <div class="share-new" id="share-new">
      <p class="share-new__note">Your new link. This link won't be shown again.</p>
      <input type="text" class="form-input" id="share-new-url" value="<%= newShareUrl %>" readonly>
      <button type="button" class="btn btn--small" id="share-copy-btn">Copy</button>
    </div>
    <% } %>

    <% if (shares.length > 0) { %>
    <ul class="share-list">
      <% shares.forEach(function(s) { %>
      <li class="share-list__item">
        <div class="share-list__info">
          <span>Created <%= s.created_at %> UTC</span>
          <span><% if (s.expired) { %><strong>Expired</strong> <% } else { %>Expires <% } %><%= s.expires_at %></span>
          <span class="share-list__badges">
            <% if (s.has_password) { %><span class="share-badge">Password protected</span><% } %>
            <% if (s.strip_metadata) { %><span class="share-badge">Metadata stripped</span><% } %>
          </span>
        </div>
        <form method="post" action="/collections/<%= collection.slug %>/shares/<%= s.id %>/delete">
          <button type="submit" class="btn btn--small btn--danger">Stop sharing</button>
        </form>
      </li>
      <% }); %>
    </ul>
    <% } else { %>
    <p class="share-empty">This collection isn't shared.</p>
    <% } %>

    <form method="post" action="/collections/<%= collection.slug %>/shares" class="modal__form-body" id="share-create-form">
      <div class="form-group">
        <label for="share-password" class="form-label">Password (optional)</label>
        <input type="password" id="share-password" name="password" class="form-input" autocomplete="new-password">
      </div>
      <div class="form-group">
        <label for="share-expiry" class="form-label">Expires after</label>
        <select id="share-expiry" name="expiry" class="form-input">
          <option value="1h">1 hour</option>
          <option value="1d" selected>1 day</option>
          <option value="7d">7 days</option>
          <option value="14d">14 days</option>
        </select>
      </div>
      <label class="share-checkbox">
        <input type="checkbox" name="strip_metadata" checked> Strip metadata (EXIF)
      </label>
      <button type="submit" class="btn modal__submit" id="share-create-btn">Create link</button>
      <button type="button" class="btn modal__cancel" id="share-close-btn">Close</button>
    </form>
  </div>
</div>

<%- include('_add-to-collection-modal') %>

<script src="/add-to-collection.js" defer></script>
<script src="/collection-detail.js" defer></script>
<script src="/share-modal.js" defer></script>
  <script src="/menu.js" defer></script>
</main>
</body>
</html>
