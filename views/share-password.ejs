<%- include('_header-public', { pageTitle: 'Password required', mainClass: 'main--centered' }) %>

    <div class="card login-card">
      <h1 class="card__title">Password required</h1>

      <% if (locals.error) { %>
      <div class="banner banner--error" role="alert"><%= locals.error %></div>
      <% } %>

      <form method="POST" action="/share/<%= token %>/unlock" class="login-form">
        <div class="form-group">
          <label for="password" class="form-label">Password</label>
          <input type="password" id="password" name="password" class="form-input" autocomplete="off" required autofocus>
        </div>
        <button type="submit" class="btn login-btn">Continue</button>
      </form>
    </div>
</main>
</body>
</html>
